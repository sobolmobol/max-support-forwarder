# MAX account and support chat
MAX_PHONE=+79990000000
MAX_TARGET_CHAT_ID=-1234567890

# Persistent state. Keep this directory between deployments.
MAX_WORK_DIR=cache
MAX_SESSION_NAME=forwarder_bot.db
MAX_STATE_DB=cache/relay_state.db

# If PyMax needs relogin, put a one-time code/password in these files.
MAX_SMS_CODE_FILE=cache/sms_code.txt
MAX_2FA_PASSWORD_FILE=cache/2fa_password.txt
# MAX_2FA_PASSWORD=do-not-commit-this

# Logging with rotation
BOT_DEBUG=false
BOT_LOG_LEVEL=INFO
PYMAX_LOG_LEVEL=WARNING
BOT_LOG_FILE=logs/bot.log
BOT_LOG_MAX_BYTES=10485760
BOT_LOG_BACKUP_COUNT=5

# Reliability
BOT_RECONNECT_DELAY=5
BOT_REQUEST_TIMEOUT=60
BOT_OUTBOX_POLL_SECONDS=2
# 0 = retry forever; messages remain in SQLite while MAX/network is unavailable.
BOT_JOB_MAX_ATTEMPTS=0
BOT_CLEANUP_INTERVAL_SECONDS=3600
BOT_MAPPING_RETENTION_DAYS=90
BOT_INCLUDE_PHONE=true
